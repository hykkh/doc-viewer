@@ -2347,6 +2348,70 @@ impl crate::wmf::converter::Player for SVGPlayer {
 /// [Task #860] Node 의 x+width attribute 합산 (viewBox 자동 확장용).
 /// `<image>`, `<rect>`, `<polygon>` 등의 좌표 attribute 를 parse 하여
 /// 최대 x+width 위치 반환. attribute 미존재 시 None.
+/// Resolves the GDI "XOR mask" idiom charts use for patterned/transparent series:
+///
+///   PATINVERT(rect, brush C) → filled shapes (mask, drawn black / with a pattern)
+///   → PATINVERT(same rect, brush C)
+///
+/// On the device the two XORs cancel outside the shapes and leave colour C inside
+/// them. Painted literally as SVG they become two opaque C rectangles covering the
+/// whole plot (the "red box" over line charts). Replace the pair with the shapes
+/// filled in C.
+fn resolve_patinvert_masks(elements: Vec<Node>) -> Vec<Node> {
+    const MAX_BETWEEN: usize = 64;
+    let key = |n: &Node| {
+        (
+            n.get("x").cloned(),
+            n.get("y").cloned(),
+            n.get("width").cloned(),
+            n.get("height").cloned(),
+            n.get("fill").cloned(),
+        )
+    };
+    let is_mark = |n: &Node| n.name() == Some("rect") && n.get(PATINVERT_MARK).is_some();
+    let is_shape = |n: &Node| matches!(n.name(), Some("path" | "polygon" | "rect" | "ellipse"));
+
+    let mut out: Vec<Option<Node>> = elements.into_iter().map(Some).collect();
+    let mut i = 0;
+    while i < out.len() {
+        let Some(first) = out[i].as_ref().filter(|n| is_mark(n)) else {
+            i += 1;
+            continue;
+        };
+        let k = key(first);
+        let fill = first.get("fill").cloned().unwrap_or_default();
+        let end = (i + 1 + MAX_BETWEEN + 1).min(out.len());
+        let closing = (i + 1..end).find(|&j| {
+            out[j].as_ref().is_some_and(|n| is_mark(n) && key(n) == k)
+        });
+        let Some(j) = closing else {
+            i += 1;
+            continue;
+        };
+        let between_ok = j > i + 1
+            && out[i + 1..j]
+                .iter()
+                .all(|n| n.as_ref().is_some_and(|n| is_shape(n) && !is_mark(n)));
+        if !between_ok {
+            i += 1;
+            continue;
+        }
+        for slot in &mut out[i + 1..j] {
+            if let Some(n) = slot.take() {
+                let filled = n.get("fill").is_some_and(|f| f != "none");
+                *slot = Some(if filled { n.set("fill", fill.as_str()) } else { n });
+            }
+        }
+        out[i] = None;
+        out[j] = None;
+        i = j + 1;
+    }
+    out.into_iter()
+        .flatten()
+        .map(|n| n.unset(PATINVERT_MARK))
+        .collect()
+}
